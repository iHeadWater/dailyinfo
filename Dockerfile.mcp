FROM python:3.12-slim

ARG UV_VERSION=0.10.9
RUN pip install --no-cache-dir "uv==${UV_VERSION}"
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY scripts/ ./scripts/
COPY config/ ./config/
RUN uv sync --frozen --extra mcp --no-dev --no-group docs --no-editable \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin mcp

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    DAILYINFO_MCP_HOST=0.0.0.0 DAILYINFO_MCP_PORT=8768 \
    DAILYINFO_MCP_DATA_ROOT=/data DAILYINFO_MCP_KEYS_FILE=/run/secrets/dailyinfo/keys.json
USER 10001:10001
EXPOSE 8768
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8768/health', timeout=3).close()"]
CMD ["/app/.venv/bin/python", "-m", "scripts.mcp_server"]
